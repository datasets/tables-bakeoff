{
  "name": "tables-evaluation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/measure-bundles.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data": "node scripts/prepare-data.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gzip-size": "^7.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "comment:overrides": "glide-data-grid 6.0.3 — the current release — still caps its React peer at 18.x, so a plain `npm install` fails against the React 19 the TanStack demo brought in. The override pins its peer to the one React in this tree rather than installing a second copy or requiring --legacy-peer-deps on every clone. Recorded in the Glide demo's meta.notes as a real friction point.",
  "overrides": {
    "@glideapps/glide-data-grid": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "6.0.3",
    "@observablehq/inputs": "0.12.0",
    "@perspective-dev/client": "^5.3.1",
    "@perspective-dev/viewer": "^5.3.1",
    "@perspective-dev/viewer-datagrid": "^5.3.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "ag-grid-community": "36.1.0",
    "hyparquet": "1.29.2",
    "hyparquet-writer": "^0.16.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tabulator-tables": "6.5.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
